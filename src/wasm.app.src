{application, wasm, [
    {description, "A WebAssembly runtime implemented in Erlang/OTP"},
    %% The OTP application is `wasm'; the Hex package is `erlang_wasm', because
    %% `wasm' on hex.pm is not ours. Depend on it as
    %% {deps, [{wasm, {pkg, erlang_wasm}}]}.
    {pkg_name, erlang_wasm},
    {vsn, "0.4.3"},
    {registered, [wasm_sup, wasm_engine, wasm_module_cache, wasm_worker_reaper]},
    {mod, {wasm_app, []}},
    %% `common_test' is optional: only `wasm_adapter_conformance', the kit an
    %% adapter author runs from Common Test, calls it.
    {applications, [kernel, stdlib, crypto, common_test]},
    {optional_applications, [common_test]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/benoitc/erlang_wasm"}]},
    %% `priv/script_v1', not `priv': the worker adapters read the boot
    %% scripts at start, and the NIF built beside them is not ours to ship.
    {files, ["src", "include", "c_src", "priv/script_v1", "scripts",
             "examples", "docs", "rebar.config", "README.md", "LICENSE",
             "CHANGELOG.md"]}
]}.
