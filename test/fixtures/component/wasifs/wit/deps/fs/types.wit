package wasi:filesystem;

interface types {
  use wasi:io/streams.{input-stream};
  enum error-code {
    access, would-block, already, bad-descriptor, busy, deadlock, quota,
    exist, file-too-large, illegal-byte-sequence, in-progress, interrupted,
    invalid, io, is-directory, loop, too-many-links, message-size,
    name-too-long, no-device, no-entry, no-lock, insufficient-memory,
    insufficient-space, not-directory, not-empty, not-recoverable, unsupported,
    no-tty, no-such-device, overflow, not-permitted, pipe, read-only,
    invalid-seek, text-file-busy, cross-device
  }
  enum descriptor-type {
    unknown, block-device, character-device, directory, fifo, symbolic-link,
    regular-file, socket
  }
  flags path-flags { symlink-follow }
  flags open-flags { create, directory, exclusive, truncate }
  flags descriptor-flags {
    read, write, file-integrity-sync, data-integrity-sync,
    requested-write-sync, mutate-directory
  }
  type filesize = u64;
  type link-count = u64;
  record datetime { seconds: u64, nanoseconds: u32 }
  record descriptor-stat {
    %type: descriptor-type,
    link-count: link-count,
    size: filesize,
    data-access-timestamp: option<datetime>,
    data-modification-timestamp: option<datetime>,
    status-change-timestamp: option<datetime>,
  }
  record directory-entry { %type: descriptor-type, name: string }
  resource directory-entry-stream {
    read-directory-entry: func() -> result<option<directory-entry>, error-code>;
  }
  resource descriptor {
    read: func(length: filesize, offset: filesize)
        -> result<tuple<list<u8>, bool>, error-code>;
    get-type: func() -> result<descriptor-type, error-code>;
    open-at: func(path-flags: path-flags, path: string, open-flags: open-flags,
                  %flags: descriptor-flags) -> result<descriptor, error-code>;
    stat: func() -> result<descriptor-stat, error-code>;
    stat-at: func(path-flags: path-flags, path: string)
        -> result<descriptor-stat, error-code>;
    read-via-stream: func(offset: filesize) -> result<input-stream, error-code>;
    read-directory: func() -> result<directory-entry-stream, error-code>;
    write: func(buffer: list<u8>, offset: filesize) -> result<filesize, error-code>;
    create-directory-at: func(path: string) -> result<_, error-code>;
    unlink-file-at: func(path: string) -> result<_, error-code>;
  }
}

interface preopens {
  use types.{descriptor};
  get-directories: func() -> list<tuple<descriptor, string>>;
}
