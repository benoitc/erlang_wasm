package example:wasifs;
world app {
  import wasi:filesystem/types;
  import wasi:filesystem/preopens;
  import wasi:io/streams;
  export cat: func(name: string) -> list<u8>;
  export present: func(name: string) -> bool;
  export root-is-dir: func() -> bool;
  export size: func(name: string) -> u64;
  export entries: func() -> list<string>;
  export slurp: func(name: string) -> list<u8>;
  export write-file: func(name: string, data: list<u8>) -> u64;
  export make-dir: func(name: string) -> bool;
  export remove: func(name: string) -> bool;
}
