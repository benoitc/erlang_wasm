package wasi:cli;

interface stdout {
  use wasi:io/streams.{output-stream};
  get-stdout: func() -> output-stream;
}

interface stdin {
  use wasi:io/streams.{input-stream};
  get-stdin: func() -> input-stream;
}

world app {
  import stdout;
  import stdin;
  import wasi:io/streams;
  import wasi:io/poll;
  export pump: func(bytes: list<u8>) -> u64;
  export peek: func() -> bool;
  export drain: func() -> list<u8>;
}
