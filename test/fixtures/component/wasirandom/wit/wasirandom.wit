// The wasi:random/random 0.2 interface, declared locally so the fixture pins no
// external WIT. Unversioned, so the host key is the bare `wasi:random/random`;
// matching a versioned `@0.2.x` import is a later step. The host supplies it
// (see src/wasi_preview2.erl).
package wasi:random;

interface random {
  get-random-bytes: func(len: u64) -> list<u8>;
  get-random-u64: func() -> u64;
}

world app {
  import random;
  export roll: func() -> u64;
  export bytes: func(n: u32) -> list<u8>;
}
