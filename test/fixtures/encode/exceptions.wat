;; Exception handling and tail calls: tags, an imported one, throw and
;; throw_ref, a try_table with every kind of handler, and the three tail
;; calls.
(module
  (import "env" "boom" (tag $boom (param i32)))
  (tag $empty)
  (type $unary (func (param i32) (result i32)))
  (table 1 funcref)
  (elem (i32.const 0) $double)
  (func $double (param i32) (result i32)
    (i32.mul (local.get 0) (i32.const 2)))
  (func (export "throw") (param i32)
    (throw $boom (local.get 0)))
  (func (export "catch") (param i32) (result i32)
    (block $caught (result i32)
      (try_table (result i32) (catch $boom $caught)
        (if (local.get 0) (then (throw $boom (i32.const 41))))
        (i32.const 0))
      (return))
    (i32.const 1)
    (i32.add))
  (func (export "rethrow")
    (block $with_ref (result exnref)
      (try_table (catch_all_ref $with_ref)
        (throw $empty))
      (return))
    (throw_ref))
  (func (export "handlers") (result i32)
    (block $all
      (block $ref (result i32 exnref)
        (try_table (catch_ref $boom $ref) (catch_all $all)
          (throw $empty))
        (return (i32.const 0)))
      (drop)
      (return))
    (i32.const 2))
  (func (export "tail") (param i32) (result i32)
    (return_call $double (local.get 0)))
  (func (export "tail_indirect") (param i32) (result i32)
    (return_call_indirect (type $unary) (local.get 0) (i32.const 0)))
  (func (export "tail_ref") (param i32) (result i32)
    (return_call_ref $unary (local.get 0) (ref.func $double))))
